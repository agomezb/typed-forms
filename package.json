{
  "name": "typed-forms",
  "version": "0.1.0",
  "private": true,
  "description": "Formularios tipados en TypeScript, sin dependencias y agnósticos de framework (React, Angular, ...).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && rm -rf .test-dist && tsc -p tsconfig.test.json && tsc -p tsconfig.test.assign.json && node --test \".test-dist/**/*.test.js\""
  },
  "devDependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
